---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { href: '/notes', label: 'notes' },
  { href: '/now', label: 'now' },
  { href: '/contact', label: 'contact' },
];

const isCurrent = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Gaurbage home">
      <span class="brand-eyebrow">abhijeet gaur's</span>
      <span class="brand-main">
        <span class="brand-text">gaurbage</span>
      </span>
    </a>

    <nav class="nav-container" aria-label="Main Navigation">
      <ul class="nav-links">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { active: isCurrent(item.href) }]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="header-actions">
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    padding-inline: var(--space-4);
    background-color: var(--bg);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(8px);
    background-color: color-mix(in srgb, var(--bg) 90%, transparent);
  }

  @media (min-width: 640px) {
    .site-header {
      padding-inline: var(--space-8);
    }
  }

  @media (min-width: 1024px) {
    .site-header {
      padding-left: var(--gutter-left);
      padding-right: var(--space-8);
    }
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--header-max-width, 1200px);
  }

  .brand {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    font-family: var(--font-mono);
    color: var(--text);
    text-decoration: none;
  }

  .brand-eyebrow {
    font-size: 0.65rem;
    font-weight: 400;
    color: var(--text-muted);
    letter-spacing: 0.02em;
    line-height: 1.1;
  }

  .brand-main {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: var(--text-base);
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .brand:hover .brand-text {
    color: var(--accent);
  }

  .status-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--status-stable);
    display: inline-block;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--status-stable) 25%, transparent);
  }

  .nav-container {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .nav-link {
    color: var(--text-muted);
    transition: color var(--transition-fast);
    padding: 2px 0;
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link.active {
    color: var(--text);
    font-weight: 600;
    border-bottom: 1.5px solid var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
  }

  @media (max-width: 540px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    
    .nav-container {
      width: 100%;
      justify-content: space-between;
    }

    .nav-links {
      gap: var(--space-3);
      font-size: var(--text-xs);
    }
  }
</style>
