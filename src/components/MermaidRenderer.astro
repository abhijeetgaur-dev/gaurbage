---
// Zero-dependency initial footprint: Mermaid is dynamically loaded only when diagrams are present
---

<div id="mermaid-script-anchor" style="display: none;"></div>

<style is:global>
  .mermaid-wrapper {
    margin: var(--space-6) 0;
    padding: var(--space-4);
    background-color: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow-x: auto;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 80px;
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  .mermaid-wrapper svg {
    max-width: 100%;
    height: auto;
  }

  .mermaid-loading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>

<script is:inline type="module">
  (async () => {
    // 1. Locate all code blocks formatted with mermaid
    const mermaidBlocks = document.querySelectorAll(
      'pre[data-language="mermaid"], pre.astro-code[data-language="mermaid"], pre.mermaid, code.language-mermaid'
    );

    if (!mermaidBlocks.length) return;

    // 2. Store original mermaid source code for theme toggle re-renders
    const diagrams = [];
    mermaidBlocks.forEach((block, index) => {
      const pre = block.tagName === 'CODE' ? block.closest('pre') || block : block;
      const code = block.textContent || '';
      const container = document.createElement('div');
      container.className = 'mermaid-wrapper';
      container.id = `mermaid-wrapper-${index}`;

      const placeholder = document.createElement('div');
      placeholder.className = 'mermaid-loading';
      placeholder.textContent = 'Rendering diagram...';
      container.appendChild(placeholder);

      pre.parentNode.replaceChild(container, pre);

      diagrams.push({
        container,
        code: code.trim(),
        id: `mermaid-svg-${index}`,
      });
    });

    // 3. Dynamically import Mermaid ESM only when diagrams exist on the page
    let mermaid;
    try {
      const module = await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs');
      mermaid = module.default;
    } catch (err) {
      console.error('Failed to load Mermaid.js', err);
      diagrams.forEach(({ container }) => {
        container.innerHTML = '<span class="mermaid-loading">Failed to load diagram engine.</span>';
      });
      return;
    }

    // 4. Render function supporting dynamic theme switching
    async function renderAllDiagrams() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      
      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'neutral',
        themeVariables: {
          fontFamily: 'JetBrains Mono, ui-monospace, monospace',
          fontSize: '13px',
          darkMode: isDark,
          primaryColor: isDark ? '#27272a' : '#f5f5f4',
          primaryTextColor: isDark ? '#f4f4f5' : '#1c1917',
          primaryBorderColor: isDark ? '#3f3f46' : '#e7e5e4',
          lineColor: isDark ? '#fb923c' : '#ea580c',
          secondaryColor: isDark ? '#1b1e22' : '#ffffff',
          tertiaryColor: isDark ? '#16181b' : '#fafaf9',
        },
        securityLevel: 'loose',
      });

      for (let i = 0; i < diagrams.length; i++) {
        const { container, code, id } = diagrams[i];
        try {
          // Generate unique ID per render to avoid duplicate DOM ID collision
          const renderId = `${id}-${Date.now()}-${i}`;
          const { svg } = await mermaid.render(renderId, code);
          container.innerHTML = svg;
        } catch (error) {
          console.error(`Mermaid render failed for diagram ${i}:`, error);
          container.innerHTML = `<pre class="mermaid-loading" style="color: var(--status-scrapped);">${error.message || 'Diagram syntax error'}</pre>`;
        }
      }
    }

    // Initial render
    await renderAllDiagrams();

    // 5. Watch for data-theme changes to re-render diagrams with updated theme
    const observer = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
          renderAllDiagrams();
          break;
        }
      }
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  })();
</script>
