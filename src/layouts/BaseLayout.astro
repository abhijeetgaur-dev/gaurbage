---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import { siteConfig } from '../data/siteConfig';
import '../styles/global.css';
import '../styles/code.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  articleDate?: string;
  articleUpdatedDate?: string;
  tags?: string[];
  wide?: boolean;
  schemaType?: 'website' | 'profile' | 'article';
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogImage = '/og-default.png',
  articleDate,
  articleUpdatedDate,
  tags = [],
  wide = false,
  schemaType,
} = Astro.props;

const siteUrl = siteConfig.siteUrl;
const cleanPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalUrl = new URL(cleanPath === '/' ? '/' : cleanPath, siteUrl).toString();

const fullTitle =
  title === siteConfig.title
    ? title
    : title.includes(siteConfig.author.name)
      ? title
      : `${title} — ${siteConfig.author.name}`;

const resolvedOgImage = new URL(ogImage, siteUrl).toString();

const resolvedSchemaType =
  schemaType || (articleDate ? 'article' : cleanPath === '/' ? 'profile' : 'website');
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.siteName} RSS Feed`} href="/rss.xml" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author.name} />
    <meta
      name="keywords"
      content="Abhijeet Gaur, Software Engineer, Backend Engineer, DevOps, Cloud Infrastructure, Gaurbage"
    />

    <!-- OpenGraph / Social -->
    <meta property="og:type" content={articleDate ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteConfig.author.name} — ${siteConfig.author.role}`} />
    {articleDate && <meta property="article:published_time" content={articleDate} />}
    {articleUpdatedDate && <meta property="article:modified_time" content={articleUpdatedDate} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteConfig.author.twitterHandle} />
    <meta name="twitter:creator" content={siteConfig.author.twitterHandle} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Schema.org Structured Data (JSON-LD) -->
    <SchemaOrg
      type={resolvedSchemaType}
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      datePublished={articleDate}
      dateModified={articleUpdatedDate}
      tags={tags}
    />

    <!-- Theme Initialization Script (Zero FOUC) -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.setAttribute('data-theme', stored);
            return;
          }
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>

  <body>
    <Header currentPath={Astro.url.pathname} />

    <main class="site-main">
      <div class:list={['site-container', { 'site-container-wide': wide }]}>
        <slot />
      </div>
    </main>

    <Footer />

    <!-- Code Block Copy Button Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const codeBlocks = document.querySelectorAll('pre.astro-code');
        codeBlocks.forEach((block) => {
          const wrapper = document.createElement('div');
          wrapper.className = 'code-block-wrapper';
          block.parentNode.insertBefore(wrapper, block);
          wrapper.appendChild(block);

          const copyBtn = document.createElement('button');
          copyBtn.className = 'copy-code-btn';
          copyBtn.innerText = 'copy';
          copyBtn.type = 'button';
          copyBtn.setAttribute('aria-label', 'Copy code to clipboard');

          copyBtn.addEventListener('click', async () => {
            const code = block.querySelector('code')?.innerText || block.innerText;
            try {
              await navigator.clipboard.writeText(code);
              copyBtn.innerText = 'copied!';
              setTimeout(() => {
                copyBtn.innerText = 'copy';
              }, 2000);
            } catch (err) {
              copyBtn.innerText = 'failed';
              setTimeout(() => {
                copyBtn.innerText = 'copy';
              }, 2000);
            }
          });

          wrapper.appendChild(copyBtn);
        });
      });
    </script>
  </body>
</html>
